# GEMINI_API_KEY : requise pour que les délibérations soient produites par Gemini.
# Sans elle l'application reste pleinement fonctionnelle : un moteur de règles
# déterministe prend le relais et l'interface l'indique explicitement.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL : identifiant du modèle utilisé pour l'analyse (optionnel).
# Défaut : gemini-2.5-flash. Un identifiant invalide n'interrompt pas le service,
# l'appel bascule sur le moteur de règles.
# GEMINI_MODEL="gemini-2.5-flash"

# PORT : port d'écoute du serveur Express (optionnel, défaut 3000).
# PORT=3000

# APP_URL : URL publique d'hébergement de l'applet.
APP_URL="MY_APP_URL"
